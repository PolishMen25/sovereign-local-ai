[Unit]
Description=Sovereign Local AI approved project knowledge index
After=local-fs.target
Before=sovereign-gateway-web.service

[Service]
Type=oneshot
User=sovereign
Group=sovereign
WorkingDirectory=/opt/sovereign/app
ExecStart=/usr/bin/python3 -B -m tools.build_project_knowledge_index --source-directory docs --database /var/lib/sovereign-gateway/knowledge.sqlite3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/opt/sovereign/app
ReadWritePaths=/var/lib/sovereign-gateway

[Install]
WantedBy=multi-user.target
