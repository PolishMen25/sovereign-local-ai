{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local-ai.invalid/core-mini-numa-comparison/v2/schema.json",
  "title": "Comparaison descriptive de deux preuves CORE-MINI",
  "description": "Contrat public fermé de la sortie du comparateur de deux preuves 0.2.0 (placement-a, placement-b). L'artefact décrit des distributions observées et leur recouvrement ; il ne désigne aucun placement gagnant, ne traduit jamais les libellés opaques en sockets et laisse le gate G4 ouvert. Aucun chemin, nom d'hôte ni identifiant de CPU ou de nœud n'y figure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "canonicalization",
    "evidence_schema_version",
    "benchmark_session_id",
    "shared_contract",
    "placements",
    "descriptive_ratios",
    "separation",
    "interpretation",
    "gate_status"
  ],
  "properties": {
    "schema_version": { "const": "core-mini-numa-comparison.v2" },
    "artifact_type": { "const": "descriptive-two-placement-comparison" },
    "canonicalization": { "const": "canonical-json-v1" },
    "evidence_schema_version": { "const": "0.2.0" },
    "benchmark_session_id": { "$ref": "#/$defs/sessionId" },
    "shared_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_contract_sha256", "workload"],
      "properties": {
        "workload_contract_sha256": { "$ref": "#/$defs/sha256" },
        "workload": { "$ref": "#/$defs/workload" }
      }
    },
    "placements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement-a", "placement-b"],
      "properties": {
        "placement-a": { "$ref": "#/$defs/placementSummary" },
        "placement-b": { "$ref": "#/$defs/placementSummary" }
      }
    },
    "descriptive_ratios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean_b_over_a",
        "median_b_over_a",
        "minimum_b_over_a",
        "maximum_b_over_a"
      ],
      "properties": {
        "mean_b_over_a": { "$ref": "#/$defs/positiveNumber" },
        "median_b_over_a": { "$ref": "#/$defs/positiveNumber" },
        "minimum_b_over_a": { "$ref": "#/$defs/positiveNumber" },
        "maximum_b_over_a": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_ranges_overlap", "outcome", "higher_median_label"],
      "properties": {
        "observed_ranges_overlap": { "type": "boolean" },
        "outcome": {
          "enum": [
            "inconclusive-overlapping-observed-ranges",
            "disjoint-observed-ranges"
          ]
        },
        "higher_median_label": {
          "enum": ["placement-a", "placement-b", "tied"]
        }
      }
    },
    "interpretation": { "const": "descriptive-only-not-a-core-placement-decision" },
    "gate_status": { "const": "g4-open" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proofId": {
      "type": "string",
      "pattern": "^proof-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^session-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_name",
        "data_mode",
        "repetitions",
        "source_revision",
        "source_archive_sha256",
        "source_tree_manifest_sha256",
        "offline_runtime_lock_sha256",
        "numpy_runtime_lock_sha256",
        "runtime_observation_sha256",
        "environment_contract_sha256",
        "model_config_sha256",
        "steps",
        "warmup_steps",
        "batch_size",
        "sequence_length",
        "learning_rate",
        "seed",
        "threads"
      ],
      "properties": {
        "model_name": { "const": "CORE-MINI-1M" },
        "data_mode": { "const": "synthetic" },
        "repetitions": { "type": "integer", "minimum": 3, "maximum": 10 },
        "source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "source_archive_sha256": { "$ref": "#/$defs/sha256" },
        "source_tree_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "offline_runtime_lock_sha256": { "$ref": "#/$defs/sha256" },
        "numpy_runtime_lock_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_observation_sha256": { "$ref": "#/$defs/sha256" },
        "environment_contract_sha256": { "$ref": "#/$defs/sha256" },
        "model_config_sha256": { "$ref": "#/$defs/sha256" },
        "steps": { "type": "integer", "minimum": 6, "maximum": 1000 },
        "warmup_steps": { "type": "integer", "minimum": 1, "maximum": 997 },
        "batch_size": { "type": "integer", "minimum": 1, "maximum": 64 },
        "sequence_length": { "type": "integer", "minimum": 2, "maximum": 512 },
        "learning_rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "seed": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "threads": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean",
        "median",
        "minimum",
        "maximum",
        "population_standard_deviation",
        "median_absolute_deviation"
      ],
      "properties": {
        "mean": { "$ref": "#/$defs/positiveNumber" },
        "median": { "$ref": "#/$defs/positiveNumber" },
        "minimum": { "$ref": "#/$defs/positiveNumber" },
        "maximum": { "$ref": "#/$defs/positiveNumber" },
        "population_standard_deviation": { "type": "number", "minimum": 0 },
        "median_absolute_deviation": { "type": "number", "minimum": 0 }
      }
    },
    "placementSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "proof_file_sha256",
        "contract_commitment_sha256",
        "repetitions_completed",
        "tokens_per_second"
      ],
      "properties": {
        "proof_id": { "$ref": "#/$defs/proofId" },
        "proof_file_sha256": { "$ref": "#/$defs/sha256" },
        "contract_commitment_sha256": { "$ref": "#/$defs/sha256" },
        "repetitions_completed": { "type": "integer", "minimum": 3, "maximum": 10 },
        "tokens_per_second": { "$ref": "#/$defs/distribution" }
      }
    }
  }
}
