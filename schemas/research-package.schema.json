{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local-ai.invalid/research-package/0.1.0/schema.json",
  "title": "Paquet de recherche souverain",
  "description": "Contrat d'ingress strict pour une recherche et sa provenance. Les déclarations d'assainissement doivent être revérifiées côté serveur ; le schéma seul ne prouve jamais l'absence de secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "lifecycle_state",
    "producer",
    "timestamps",
    "request",
    "response",
    "sources",
    "citations",
    "attachments",
    "usage",
    "cost",
    "generation_parameters",
    "errors",
    "security",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "lifecycle_state": {
      "const": "RAW",
      "description": "Un producteur externe ne peut déclarer qu'un paquet RAW. Les états internes ultérieurs sont portés par le journal de cycle de vie."
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "timestamps": {
      "$ref": "#/$defs/timestamps"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "response": {
      "$ref": "#/$defs/response"
    },
    "sources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/attachmentMetadata"
      }
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "generation_parameters": {
      "type": "array",
      "maxItems": 100,
      "description": "Paramètres non secrets. Les valeurs structurées sont sérialisées en JSON canonique dans une chaîne.",
      "items": {
        "$ref": "#/$defs/generationParameter"
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/sanitizedError"
      }
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider_request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Identifiant de corrélation non sensible ; jamais un jeton de session ou d’accès."
        },
        "gateway_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "request_started_at",
        "response_completed_at",
        "collected_at"
      ],
      "properties": {
        "created_at": {
          "$ref": "#/$defs/dateTime"
        },
        "request_started_at": {
          "$ref": "#/$defs/dateTime"
        },
        "response_completed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "collected_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "controlled_system_prompt": {
          "$ref": "#/$defs/controlledSystemPrompt"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Identifiant stable non sensible, jamais un cookie ni un jeton de session."
        }
      }
    },
    "controlledSystemPrompt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Présent uniquement si le prompt est contrôlé par le Gateway, un opérateur local ou un modèle de prompt approuvé.",
      "required": [
        "text",
        "controlled_by",
        "sha256"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "controlled_by": {
          "type": "string",
          "enum": [
            "research_gateway",
            "local_operator",
            "approved_template"
          ]
        },
        "template_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 2000000
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "finish_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "provider_status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "failed"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "retrieved_at"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "web",
            "document",
            "dataset",
            "api",
            "conversation",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 4096,
          "description": "URL HTTPS déclarée publique, canonique et assainie, sans paramètre d’accès ni signature. Le serveur doit encore bloquer identifiants, IP privées, DNS rebinding et redirections interdites."
        },
        "title": {
          "type": "string",
          "maxLength": 2000
        },
        "publisher": {
          "type": "string",
          "maxLength": 500
        },
        "authors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "published_at": {
          "$ref": "#/$defs/dateTime"
        },
        "retrieved_at": {
          "$ref": "#/$defs/dateTime"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
          "maxLength": 255
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "source_id"
      ],
      "properties": {
        "citation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "response_start": {
          "type": "integer",
          "minimum": 0
        },
        "response_end": {
          "type": "integer",
          "minimum": 0
        },
        "locator": {
          "type": "string",
          "maxLength": 1000,
          "description": "Page, section, paragraphe ou autre repère non sensible."
        },
        "quoted_text_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "dependentRequired": {
        "response_start": [
          "response_end"
        ],
        "response_end": [
          "response_start"
        ]
      }
    },
    "attachmentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "Métadonnées uniquement ; aucun contenu binaire ni justificatif d’accès.",
      "required": [
        "attachment_id",
        "filename",
        "media_type",
        "byte_size",
        "content_sha256"
      ],
      "properties": {
        "attachment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\\\/\\u0000-\\u001F]+$"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$",
          "maxLength": 255
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 4096,
          "description": "URL HTTPS déclarée publique, canonique et assainie, sans signature ni jeton. Le serveur applique aussi ses contrôles SSRF."
        },
        "created_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "estimated": {
          "type": "boolean"
        }
      },
      "dependentRequired": {
        "amount": [
          "currency",
          "estimated"
        ],
        "currency": [
          "amount",
          "estimated"
        ],
        "estimated": [
          "amount",
          "currency"
        ]
      }
    },
    "generationParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?!.*(?:api[_-]?key|access[_-]?token|refresh[_-]?token|auth(?:orization)?|password|passwd|secret|credential|cookie|private[_-]?key))[a-z][a-z0-9_.-]{0,63}$"
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 10000
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "sanitizedError": {
      "type": "object",
      "additionalProperties": false,
      "description": "Erreur assainie : aucune pile, en-tête, charge brute, clé ou valeur d’authentification.",
      "required": [
        "code",
        "phase",
        "message",
        "retryable",
        "occurred_at"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "request",
            "provider",
            "collection",
            "attachment",
            "validation"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        },
        "occurred_at": {
          "$ref": "#/$defs/dateTime"
        },
        "provider_http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "provider_error_type": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_secret_scan_status",
        "redaction_policy_version",
        "scanned_at",
        "redactions_count"
      ],
      "properties": {
        "producer_secret_scan_status": {
          "const": "passed",
          "description": "Auto-attestation du producteur, non fiable à elle seule. Le Collector répète le contrôle avant tout dépôt durable."
        },
        "redaction_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scanned_at": {
          "$ref": "#/$defs/dateTime"
        },
        "redactions_count": {
          "type": "integer",
          "minimum": 0
        },
        "redacted_categories": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": {
            "type": "string",
            "enum": [
              "api_key",
              "access_token",
              "cookie",
              "credential",
              "password",
              "private_key",
              "session_identifier",
              "signed_url",
              "personal_data",
              "other"
            ]
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "hash_scope",
        "package_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "hash_scope": {
          "const": "canonical-package-excluding-integrity"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provider_raw_response_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Empreinte facultative des octets de réponse fournisseur conservés séparément. Ce champ n'est jamais l'empreinte du paquet JSON qui le contient."
        }
      }
    }
  }
}

