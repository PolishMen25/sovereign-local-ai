{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local-ai.invalid/training-corpus-manifest/0.1.0/schema.json",
  "title": "Manifest de corpus d'entraînement souverain",
  "description": "Contrat de lignée pour un corpus déjà validé. Il décrit des empreintes et décisions, jamais le contenu du corpus ni un chemin interne.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "lifecycle_state",
    "classification",
    "materialization",
    "source_packages",
    "splits",
    "tokenizer_contract",
    "approvals"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "corpus_id": { "type": "string", "pattern": "^corpus-[a-z0-9][a-z0-9-]{2,62}$" },
    "lifecycle_state": { "const": "VALIDATED" },
    "classification": { "enum": ["synthetic", "approved_training"] },
    "materialization": { "$ref": "#/$defs/materialization" },
    "source_packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/sourcePackage" }
    },
    "splits": { "$ref": "#/$defs/splits" },
    "tokenizer_contract": { "$ref": "#/$defs/tokenizerContract" },
    "approvals": { "$ref": "#/$defs/approvals" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "content_sha256", "byte_size", "record_count"],
      "properties": {
        "format": { "const": "jsonl-utf8" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "byte_size": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
        "record_count": { "type": "integer", "minimum": 1, "maximum": 1000000000000 }
      }
    },
    "sourcePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "provenance_id", "content_sha256", "license", "languages", "review_state"],
      "properties": {
        "package_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "provenance_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "license": { "type": "string", "minLength": 1, "maxLength": 200 },
        "languages": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$" } },
        "review_state": { "const": "approved" }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_ids", "content_sha256", "record_count"],
      "properties": {
        "package_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" } },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "record_count": { "type": "integer", "minimum": 1 }
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": { "$ref": "#/$defs/split" },
        "validation": { "$ref": "#/$defs/split" },
        "test": { "$ref": "#/$defs/split" }
      }
    },
    "tokenizerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_encoding", "normalization_policy_id", "candidate_vocabulary_size", "review_state"],
      "properties": {
        "input_encoding": { "const": "utf-8" },
        "normalization_policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
        "candidate_vocabulary_size": { "type": "integer", "minimum": 256, "maximum": 262144 },
        "review_state": { "enum": ["pending", "approved"] }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_governance", "training_authorization"],
      "properties": {
        "data_governance": { "enum": ["pending", "approved"] },
        "training_authorization": { "enum": ["not_approved", "approved"] }
      }
    }
  }
}
